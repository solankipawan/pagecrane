<?xml version="1.0" encoding="utf-8"?>
<!-- Android 5–11 splash: app background + rounded icon (from Design/export-icons.sh).
     Android 12+ uses values-v31/styles.xml instead. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_bg" />
    <item>
        <bitmap android:gravity="center" android:src="@drawable/splash_icon" />
    </item>
</layer-list>
