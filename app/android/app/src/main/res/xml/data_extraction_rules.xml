<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: scanned documents (app files) never leave the device through
     Google Drive backup or phone-to-phone transfer. Settings (shared prefs) may. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
